# Jyot Agentic Multimodal Monitor - Environment Configuration Example
# Copy this file to .env and customize as needed. Do not commit secrets or API keys.

# Planner Configuration
JYOT_PLANNER_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
JYOT_STRICT_LLM=false

# Optional Vision Model (leave empty for OCR-only mode)
JYOT_VISION_MODEL=

# Execution Budgets
JYOT_MAX_STEPS_PER_ITEM=10
JYOT_PER_ITEM_BUDGET_USD=0.10
JYOT_PER_RUN_BUDGET_USD=5.00

# Logging & Storage
JYOT_LOG_LEVEL=INFO
JYOT_DB_PATH=artifacts/monitor.db
JYOT_ARTIFACTS_DIR=artifacts
